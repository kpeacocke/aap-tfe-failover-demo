# HCP Terraform organization name (not an API token).
HCP_TERRAFORM_ORGANIZATION=your-hcp-terraform-organization

# Create a user/team token in HCP Terraform. Keep this file private.
TF_TOKEN_app_terraform_io=

# Optional operational API access. HCP uses the token above by default.
# For Terraform Enterprise, set the HTTPS base URL and a separate API token.
# Provisioning with scripts/terraform.sh still targets app.terraform.io.
# TFE_ADDRESS=https://app.terraform.io
# TFE_TOKEN=''
# Optional trusted CA bundle for a private Terraform Enterprise endpoint.
# SSL_CERT_FILE=/absolute/path/to/ca-bundle.pem

# RHDP lab credential mapping:
# "AWS Access Key" -> AWS_ACCESS_KEY_ID
# "AWS Secret Key" -> AWS_SECRET_ACCESS_KEY
# Paste only the lab-issued keys between the single quotes.
AWS_ACCESS_KEY_ID=''
AWS_SECRET_ACCESS_KEY=''

# Set only if the lab also supplies an AWS session token.
# Blank values clear any inherited session token when using non-session keys.
AWS_SESSION_TOKEN=''
AWS_SECURITY_TOKEN=''

# Blank values avoid selecting an inherited personal AWS profile.
# Alternative: set AWS_PROFILE to an existing profile and remove the access-key
# and token lines above. IAM Identity Center/SSO profiles are also supported.
AWS_PROFILE=''
AWS_DEFAULT_PROFILE=''

# "AWS Console URL", "AWS Console User", and "AWS Console Password" are for
# browser sign-in only. Terraform does not need them; do not store them here.

# Required for supported bootstrap/teardown: pin your own 12-digit AWS account.
# Terraform rejects credentials for another account when this is populated.
TF_VAR_aws_account_id=

# Required: region used by the lab's AWS demo workloads.
# Check the completed AAP AWS workflow's region input; do not guess.
# No Sydney or personal-profile region fallback is used.
TF_VAR_aws_region=

# Run bash scripts/create-ssh-key.sh first. Terraform registers only the public
# key. Relative paths below are resolved from the repository root.
SSH_PRIVATE_KEY_PATH=.local/ssh/ww-demo
SSH_PUBLIC_KEY_PATH=.local/ssh/ww-demo.pub

# Alternative: reuse an existing key pair ONLY if you have its private key.
# TF_VAR_ssh_key_pair_name=your-existing-ec2-key-pair
# SSH_PRIVATE_KEY_PATH=/absolute/path/to/the-matching-key.pem

# Public IPv4 CIDR allowed to SSH to HAProxy; use your current public IP with /32.
TF_VAR_admin_cidr=203.0.113.10/32

# Used by the DC workspaces to read outputs from ww-demo-shared.
# Set this to the same organization name as HCP_TERRAFORM_ORGANIZATION.
TF_VAR_terraform_organization=your-hcp-terraform-organization

# Filled in after provisioning, from the shared workspace's frontdoor_public_ip.
HAPROXY_PUBLIC_IP=

# Runtime failover. Must match the deployed application version.
TF_VAR_application_version=1.0.0
# Planned drain aborts on timeout, then restores the source only if healthy.
FAILOVER_DRAIN_TIMEOUT_SECONDS=60
# Existing RHDP AAP 2.7 instance; never install or upgrade it.
# Use the Controller Console URL's HTTPS base URL, without a UI path.
AAP_HOSTNAME=''
AAP_USERNAME=''
AAP_PASSWORD=''
# Alternatively, set AAP_TOKEN and leave username/password blank.
# AAP_TOKEN=''
AAP_VALIDATE_CERTS=true
# Existing namespace containing AAP; used only for demo-image pull permissions.
AAP_OPENSHIFT_NAMESPACE=aap
# Set after build-ee reports the internal registry image digest.
DEMO_EE_IMAGE=''
# The AAP project follows main unless a specific commit is supplied.
DEMO_SCM_REVISION=main
# Optional: otherwise install generates/reuses .local/aap-operator-password.
# DEMO_OPERATOR_PASSWORD=''
# Presenter status and read-only browser checks require this verified HTTPS
# Portal base URL without a trailing slash.
# DEMO_PORTAL_URL=https://your-portal-route
# Traffic-changing failure smoke is a separate per-command opt-in.
# Do not enable DEMO_LIVE_FAILURE_SMOKE by default in this file.
# Set only after the AAP readiness job verifies its execution-pod egress.
# TF_VAR_aap_ssh_cidr=203.0.113.20/32
# Existing RHDP OpenShift; used for a demo-owned execution environment build.
# Copy the API URL and short-lived token from "Copy login command".
OPENSHIFT_API_URL=''
OPENSHIFT_TOKEN=''
OPENSHIFT_VALIDATE_CERTS=true
# Prefer a trusted private CA rather than disabling verification.
# OPENSHIFT_CA_CERT=/absolute/path/to/cluster-ca.pem
# Explicitly approve copying only registry.redhat.io from RHDP's
# existing cluster pull secret into the demo Portal namespace. Never assumed.
DEMO_PORTAL_REUSE_CLUSTER_REGISTRY_AUTH=false
# Set only for an authorized failover/recovery/switchback sequence; default is read-only tests.
# DEMO_PORTAL_LIVE_OPERATIONS=true

# Lifecycle uses Python 3.12-3.14 and requires the explicit AWS account pin above.
# Override the Python executable only when needed:
# BOOTSTRAP_PYTHON=python3.14
# Non-secret lifecycle settings: profiles/demo.yml
# Teardown is read-only unless --confirm-destroy is explicitly supplied.
